{
    "name": "githd-local",
    "displayName": "Git History Diff Local",
    "description": "View git history. View diff of committed files. View git blame info. View stash details.",
    "version": "2.5.11",
    "publisher": "wikichen",
    "author": {
        "name": "Hui Zhou",
        "email": "zhou_hui@outlook.com"
    },
    "engines": {
        "vscode": "^1.91.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/huizhougit/githd.git"
    },
    "icon": "media/icons/icon.png",
    "categories": [
        "Other"
    ],
    "keywords": [
        "git",
        "diff",
        "git diff",
        "git log",
        "git history",
        "git history diff",
        "githd-local"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./dist/extension",
    "contributes": {
        "languages": [
            {
                "id": "githd-local",
                "icon": {
                    "light": "media/icons/githd.svg",
                    "dark": "media/icons/githd.svg"
                }
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Git History Diff configuration",
            "properties": {
                "githd-local.explorerView.withFolder": {
                    "type": "boolean",
                    "default": true,
                    "description": "List committed files with the folders."
                },
                "githd-local.logView.commitsCount": {
                    "type": "number",
                    "default": 300,
                    "markdownDescription": "The commits count listed in history view. Other than setting it, you can load more logs with clicking `...` or load the entire log with command.",
                    "enum": [
                        100,
                        200,
                        300,
                        400,
                        500,
                        1000
                    ]
                },
                "githd-local.logView.expressMode": {
                    "type": "boolean",
                    "default": false,
                    "description": "The Express Mode will load the history view much faster when the number of commits is large. But the change stats and the stats chart will not be present."
                },
                "githd-local.logView.displayExpressStatus": {
                    "type": "boolean",
                    "default": true,
                    "description": "Display the express mode setting on the status bar"
                },
                "githd-local.blameView.enabled": {
                    "type": "string",
                    "default": "detail",
                    "enum": [
                        "disabled",
                        "blame",
                        "detail"
                    ],
                    "markdownDescription": "Show git blame information for each line. `disabled`: disabled, `blame`: show blame info only, `detail`: show blame info with hover messages"
                },
                "githd-local.editor.disabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Disable GitHD Local shortcut in editor"
                },
                "githd-local.traceLevel": {
                    "type": "string",
                    "default": "silent",
                    "description": "The trace level set to see githd-local logs from output window.",
                    "enum": [
                        "silent",
                        "error",
                        "warning",
                        "info",
                        "verbose"
                    ]
                },
                "githd-local.cacheEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Cache some git data to improve performance. Whenever there is a change under .git the cache will be updated."
                },
                "githd-local.statsView.dataBucketsCount": {
                    "type": "number",
                    "default": 91,
                    "description": "The number of buckets to display in the stats view. The bigger the value you set, the higher resolution the chart will be."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "githd-local-explorer",
                    "title": "GitHD Local",
                    "icon": "media/icons/githd.svg"
                }
            ],
            "panel": [
                {
                    "id": "githd-local-panel",
                    "title": "GitHD Local",
                    "icon": "media/icons/githd.svg"
                }
            ]
        },
        "views": {
            "githd-local-explorer": [
                {
                    "id": "githd-local.files",
                    "name": "Committed Files",
                    "when": "githd-local.hasGitRepo"
                }
            ],
            "githd-local-panel": [
                {
                    "id": "githd-local.stats",
                    "type": "webview",
                    "name": "Stats",
                    "when": "githd-local.hasGitRepo && !githd-local.expressMode"
                }
            ]
        },
        "commands": [
            {
                "command": "githd-local.inputRef",
                "title": "Input Ref",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.viewHistory",
                "title": "GitHD Local: View History",
                "icon": {
                    "light": "media/icons/githd.svg",
                    "dark": "media/icons/githd.svg"
                }
            },
            {
                "command": "githd-local.goBackHistoryView",
                "title": "Go Back",
                "category": "GitHD Local",
                "icon": {
                    "light": "media/icons/light/arrow-left.svg",
                    "dark": "media/icons/dark/arrow-left.svg"
                }
            },
            {
                "command": "githd-local.goForwardHistoryView",
                "title": "Go Forward",
                "category": "GitHD Local",
                "icon": {
                    "light": "media/icons/light/arrow-rightt.svg",
                    "dark": "media/icons/dark/arrow-right.svg"
                }
            },
            {
                "command": "githd-local.viewBranchHistory",
                "title": "View Branch History",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.viewAllHistory",
                "title": "View Entire History",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.diffBranch",
                "title": "View Branch Diff",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.diffThreeDot",
                "title": "Three-dot Diff (PR): Select Base and Head",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.diffMain",
                "title": "Three-dot Diff (PR): Current Branch vs main",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.viewFileHistory",
                "title": "GitHD Local: View File History"
            },
            {
                "command": "githd-local.viewLineHistory",
                "title": "GitHD Local: View Line History"
            },
            {
                "command": "githd-local.viewFolderHistory",
                "title": "GitHD Local: View Folder History"
            },
            {
                "command": "githd-local.diffFile",
                "title": "GitHD Local: View File Diff"
            },
            {
                "command": "githd-local.diffFolder",
                "title": "GitHD Local: View Folder Diff"
            },
            {
                "command": "githd-local.diffFileFromTreeView",
                "title": "View file diff with this version",
                "icon": "$(diff-single)"
            },
            {
                "command": "githd-local.diffFolderFromTreeView",
                "title": "View folder diff with this version",
                "icon": "$(diff-multiple)"
            },
            {
                "command": "githd-local.diffCommitFromTreeView",
                "title": "View all diff with this version",
                "icon": "$(diff-multiple)"
            },
            {
                "command": "githd-local.openCommit",
                "title": "Open commit with the given sha",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.openCommittedFile",
                "title": "Open the change of the committed file",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.openCommitInfo",
                "title": "Open the commit information",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.openLineDiff",
                "title": "Open the diff of the specified line",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.diffUncommittedFile",
                "title": "GitHD Local: View Un-committed File Diff"
            },
            {
                "command": "githd-local.setExpressMode",
                "title": "set Express Mode"
            },
            {
                "command": "githd-local.goBackFilesView",
                "title": "Go Back",
                "icon": {
                    "light": "media/icons/light/arrow-left.svg",
                    "dark": "media/icons/dark/arrow-left.svg"
                }
            },
            {
                "command": "githd-local.goBackNoMore",
                "title": "No More",
                "icon": {
                    "light": "media/icons/light/arrow-left-no-more.svg",
                    "dark": "media/icons/dark/arrow-left-no-more.svg"
                }
            },
            {
                "command": "githd-local.goForwardFilesView",
                "title": "Go Forward",
                "icon": {
                    "light": "media/icons/light/arrow-right.svg",
                    "dark": "media/icons/dark/arrow-right.svg"
                }
            },
            {
                "command": "githd-local.refreshFilesView",
                "title": "Refresh",
                "icon": "$(refresh)"
            },
            {
                "command": "githd-local.goForwardNoMore",
                "title": "No More",
                "icon": {
                    "light": "media/icons/light/arrow-right-no-more.svg",
                    "dark": "media/icons/dark/arrow-right-no-more.svg"
                }
            },
            {
                "command": "githd-local.previousCommit",
                "title": "Previous Commit (Older One)",
                "icon": {
                    "light": "media/icons/light/fold-down.svg",
                    "dark": "media/icons/dark/fold-down.svg"
                }
            },
            {
                "command": "githd-local.previousCommitNoMore",
                "title": "No More Previous",
                "icon": {
                    "light": "media/icons/light/fold-down-no-more.svg",
                    "dark": "media/icons/dark/fold-down-no-more.svg"
                }
            },
            {
                "command": "githd-local.nextCommit",
                "title": "Next Commit (Newer One)",
                "icon": {
                    "light": "media/icons/light/fold-up.svg",
                    "dark": "media/icons/dark/fold-up.svg"
                }
            },
            {
                "command": "githd-local.nextCommitNoMore",
                "title": "No More Next",
                "icon": {
                    "light": "media/icons/light/fold-up-no-more.svg",
                    "dark": "media/icons/dark/fold-up-no-more.svg"
                }
            },
            {
                "command": "githd-local.showFilesTreeView",
                "title": "View as Tree",
                "category": "GitHD Local",
                "icon": "$(list-tree)"
            },
            {
                "command": "githd-local.showFilesListView",
                "title": "View as List",
                "category": "GitHD Local",
                "icon": "$(list-flat)"
            },
            {
                "command": "githd-local.collapseFolder",
                "title": "Collapse All",
                "category": "GitHD Local",
                "icon": "$(collapse-all)"
            },
            {
                "command": "githd-local.expandFolder",
                "title": "Expand All",
                "category": "GitHD Local",
                "icon": "$(expand-all)"
            },
            {
                "command": "githd-local.clearFilesView",
                "title": "Clear Files View",
                "category": "GitHD Local",
                "icon": "$(clear-all)"
            },
            {
                "command": "githd-local.viewFileHistoryFromTree",
                "title": "View File History",
                "category": "GitHD Local",
                "icon": "$(history)"
            },
            {
                "command": "githd-local.viewFolderHistoryFromTree",
                "title": "View Folder History",
                "category": "GitHD Local",
                "icon": "$(history)"
            },
            {
                "command": "githd-local.openFile",
                "title": "Open File",
                "category": "GitHD Local",
                "icon": "$(go-to-file)"
            },
            {
                "command": "githd-local.showFileStats",
                "title": "Show File Stats",
                "category": "GitHD Local",
                "icon": "$(eye)"
            },
            {
                "command": "githd-local.hideFileStats",
                "title": "Hide File Stats",
                "category": "GitHD Local",
                "icon": "$(eye-closed)"
            },
            {
                "command": "githd-local.copyCommitHash",
                "title": "Copy Commit Hash",
                "category": "GitHD Local",
                "icon": "$(copy)"
            },
            {
                "command": "githd-local.viewStashes",
                "title": "View Stashes",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.setRepository",
                "title": "Set Git Repository",
                "category": "GitHD Local"
            },
            {
                "command": "githd-local.showStats",
                "title": "Show Stats",
                "category": "GitHD Local"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "githd-local.viewHistory",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.viewAllHistory",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.viewBranchHistory",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.diffBranch",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.diffThreeDot",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.diffMain",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.inputRef",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.viewStashes",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.clearFilesView",
                    "when": "false"
                },
                {
                    "command": "githd-local.openCommit",
                    "when": "false"
                },
                {
                    "command": "githd-local.openCommittedFile",
                    "when": "false"
                },
                {
                    "command": "githd-local.viewFileHistory",
                    "when": "githd-local.hasGitRepo && editorIsOpen"
                },
                {
                    "command": "githd-local.viewLineHistory",
                    "when": "githd-local.hasGitRepo && editorIsOpen"
                },
                {
                    "command": "githd-local.diffUncommittedFile",
                    "when": "githd-local.hasGitRepo && editorIsOpen"
                },
                {
                    "command": "githd-local.viewFolderHistory",
                    "when": "false"
                },
                {
                    "command": "githd-local.goBackHistoryView",
                    "when": "githd-local.canGoBackHistoryView"
                },
                {
                    "command": "githd-local.goForwardHistoryView",
                    "when": "githd-local.canGoForwardHistoryView"
                },
                {
                    "command": "githd-local.setRepository",
                    "when": "githd-local.hasGitRepo"
                },
                {
                    "command": "githd-local.diffFile",
                    "when": "false"
                },
                {
                    "command": "githd-local.diffFolder",
                    "when": "false"
                },
                {
                    "command": "githd-local.setExpressMode",
                    "when": "false"
                },
                {
                    "command": "githd-local.showFilesTreeView",
                    "when": "false"
                },
                {
                    "command": "githd-local.showFilesListView",
                    "when": "false"
                },
                {
                    "command": "githd-local.collapseFolder",
                    "when": "false"
                },
                {
                    "command": "githd-local.expandFolder",
                    "when": "false"
                },
                {
                    "command": "githd-local.viewFileHistoryFromTree",
                    "when": "false"
                },
                {
                    "command": "githd-local.viewFolderHistoryFromTree",
                    "when": "false"
                },
                {
                    "command": "githd-local.diffFileFromTreeView",
                    "when": "false"
                },
                {
                    "command": "githd-local.diffFolderFromTreeView",
                    "when": "false"
                },
                {
                    "command": "githd-local.openCommitInfo",
                    "when": "false"
                },
                {
                    "command": "githd-local.openLineDiff",
                    "when": "false"
                },
                {
                    "command": "githd-local.goBackFilesView",
                    "when": "false"
                },
                {
                    "command": "githd-local.goBackNoMore",
                    "when": "false"
                },
                {
                    "command": "githd-local.goForwardFilesView",
                    "when": "false"
                },
                {

                    "command": "githd-local.refreshFilesView",
                    "when": "false"
                },
                {
                    "command": "githd-local.goForwardNoMore",
                    "when": "false"
                },
                {
                    "command": "githd-local.previousCommit",
                    "when": "false"
                },
                {
                    "command": "githd-local.nextCommit",
                    "when": "false"
                },
                {
                    "command": "githd-local.previousCommitNoMore",
                    "when": "false"
                },
                {
                    "command": "githd-local.nextCommitNoMore",
                    "when": "false"
                },
                {
                    "command": "githd-local.openFile",
                    "when": "false"
                },
                {
                    "command": "githd-local.showFileStats",
                    "when": "false"
                },
                {
                    "command": "githd-local.hideFileStats",
                    "when": "false"
                },
                {
                    "command": "githd-local.copyCommitHash",
                    "when": "false"
                },
                {
                    "command": "githd-local.showStats",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "githd-local.goBackFilesView",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && githd-local.canGoBackFilesView",
                    "group": "navigation@1"
                },
                {
                    "command": "githd-local.goBackNoMore",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && !githd-local.canGoBackFilesView",
                    "group": "navigation@1"
                },
                {
                    "command": "githd-local.goForwardFilesView",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && githd-local.canGoForwardFilesView",
                    "group": "navigation@2"
                },
                {
                    "command": "githd-local.goForwardNoMore",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && !githd-local.canGoForwardFilesView",
                    "group": "navigation@2"
                },
                {
                    "command": "githd-local.previousCommit",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && githd-local.hasPreviousCommit",
                    "group": "navigation@3"
                },
                {
                    "command": "githd-local.previousCommitNoMore",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && !githd-local.hasPreviousCommit",
                    "group": "navigation@3"
                },
                {
                    "command": "githd-local.nextCommit",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && githd-local.hasNextCommit",
                    "group": "navigation@4"
                },
                {
                    "command": "githd-local.nextCommitNoMore",
                    "when": "view == githd-local.files && githd-local.hasGitRepo && !githd-local.hasNextCommit",
                    "group": "navigation@4"
                },
                                {
                    "command": "githd-local.refreshFilesView",
                    "when": "view == githd-local.files && githd-local.hasGitRepo",
                    "group": "navigation@8"
                },
                {
                    "command": "githd-local.clearFilesView",
                    "when": "view == githd-local.files && githd-local.hasGitRepo",
                    "group": "navigation@9"
                }
            ],
            "view/item/context": [
                {
                    "command": "githd-local.openFile",
                    "when": "view == githd-local.files && viewItem == file",
                    "group": "inline@1"
                },
                {
                    "command": "githd-local.copyCommitHash",
                    "when": "view == githd-local.files && viewItem =~ /^root-folder-/",
                    "group": "inline@1"
                },
                {
                    "command": "githd-local.copyCommitHash",
                    "when": "view == githd-local.files && viewItem =~ /^root-folder-/",
                    "group": "copy"
                },
                {
                    "command": "githd-local.showFileStats",
                    "when": "view == githd-local.files && viewItem =~ /^root-folder-/ && !githd-local.fileWithStats",
                    "group": "inline@2"
                },
                {
                    "command": "githd-local.hideFileStats",
                    "when": "view == githd-local.files && viewItem =~ /^root-folder-/ && githd-local.fileWithStats",
                    "group": "inline@2"
                },
                {
                    "command": "githd-local.diffFileFromTreeView",
                    "when": "view == githd-local.files && viewItem == file && githd-local.commitsView",
                    "group": "inline@3"
                },
                {
                    "command": "githd-local.diffCommitFromTreeView",
                    "when": "view == githd-local.files && viewItem =~ /^root-folder-/ && githd-local.commitsView",
                    "group": "inline@3"
                },
                {
                    "command": "githd-local.diffFolderFromTreeView",
                    "when": "view == githd-local.files && viewItem =~ /^folder-/ && githd-local.commitsView",
                    "group": "inline@3"
                },
                {
                    "command": "githd-local.viewFileHistoryFromTree",
                    "when": "view == githd-local.files && viewItem == file",
                    "group": "inline@4"
                },
                {
                    "command": "githd-local.viewFolderHistoryFromTree",
                    "when": "view == githd-local.files && viewItem =~ /^folder-/",
                    "group": "inline@4"
                },
                {
                    "command": "githd-local.showFilesTreeView",
                    "when": "view == githd-local.files && viewItem =~ /-list$/",
                    "group": "inline@5"
                },
                {
                    "command": "githd-local.showFilesListView",
                    "when": "view == githd-local.files && viewItem =~ /-tree$/",
                    "group": "inline@5"
                },
                {
                    "command": "githd-local.expandFolder",
                    "when": "view == githd-local.files && viewItem =~ /folder-/",
                    "group": "inline@6"
                },
                {
                    "command": "githd-local.collapseFolder",
                    "when": "view == githd-local.files && viewItem =~ /folder-/",
                    "group": "inline@7"
                }
            ],
            "explorer/context": [
                {
                    "command": "githd-local.viewFileHistory",
                    "when": "!explorerResourceIsFolder",
                    "group": "githd-local@1"
                },
                {
                    "command": "githd-local.viewFolderHistory",
                    "when": "explorerResourceIsFolder",
                    "group": "githd-local@1"
                },
                {
                    "command": "githd-local.diffFile",
                    "when": "!explorerResourceIsFolder",
                    "group": "githd-local@2"
                },
                {
                    "command": "githd-local.diffFolder",
                    "when": "explorerResourceIsFolder",
                    "group": "githd-local@2"
                },
                {
                    "command": "githd-local.diffUncommittedFile",
                    "when": "!explorerResourceIsFolder",
                    "group": "githd-local@3"
                }
            ],
            "editor/context": [
                {
                    "command": "githd-local.viewFileHistory",
                    "group": "githd-local@1"
                },
                {
                    "command": "githd-local.viewLineHistory",
                    "group": "githd-local@1"
                },
                {
                    "command": "githd-local.diffFile",
                    "group": "githd-local@2"
                },
                {
                    "command": "githd-local.diffUncommittedFile",
                    "group": "githd-local@3"
                }
            ],
            "editor/title": [
                {
                    "command": "githd-local.viewHistory",
                    "when": "githd-local.hasGitRepo && !githd-local.disableInEditor",
                    "group": "navigation@1"
                },
                {
                    "command": "githd-local.goBackHistoryView",
                    "when": "resourceScheme == githd-local-logs && githd-local.canGoBackHistoryView",
                    "group": "navigation@2"
                },
                {
                    "command": "githd-local.goBackNoMore",
                    "when": "resourceScheme == githd-local-logs && !githd-local.canGoBackHistoryView",
                    "group": "navigation@2"
                },
                {
                    "command": "githd-local.goForwardHistoryView",
                    "when": "resourceScheme == githd-local-logs && githd-local.canGoForwardHistoryView",
                    "group": "navigation@3"
                },
                {
                    "command": "githd-local.goForwardNoMore",
                    "when": "resourceScheme == githd-local-logs && !githd-local.canGoForwardHistoryView",
                    "group": "navigation@3"
                }
            ]
        },
